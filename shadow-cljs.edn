;; :deps true 表示依赖和源码路径全部交给 deps.edn 管，
;; 这里只管构建配置。npm 端的依赖在 package.json。
{:deps {:aliases [:dev]}
 :dev-http {8000 "public"}
 :nrepl {:port 9000}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn app.core/start}}
        :devtools {:preloads [uix.preload]}}}}
